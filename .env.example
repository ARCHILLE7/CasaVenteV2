# GEMINI_API_KEY: Required if optional AI features are configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign authentication JWT tokens in production.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# SQLITE_DB_PATH: Optional path to SQLite database file (defaults to ./data/casavente.sqlite).
SQLITE_DB_PATH="./data/casavente.sqlite"

# CMI_MERCHANT_ID / CMI_STORE_KEY: Required before enabling live online card payments in Morocco.
CMI_MERCHANT_ID=""
CMI_STORE_KEY=""
