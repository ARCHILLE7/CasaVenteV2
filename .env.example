# ==============================================================================
# CasaVente - Modèle de Variables d'Environnement (.env.example)
# ==============================================================================
# Copiez ce fichier vers `.env` en local ou configurez ces variables dans les
# secrets de votre plateforme d'hébergement. Ne mettez JAMAIS de vrais secrets ici.
#
# Bonnes pratiques de sécurité :
# 1. Ne commitez jamais `.env` (protégé par .gitignore).
# 2. Ne préfixez jamais une clé privée par `VITE_` (exposée dans le bundle navigateur).
# 3. Exigez `sslmode=require` pour toute base de données PostgreSQL/Supabase distante.
# 4. Générez des secrets uniques : `openssl rand -hex 64` (JWT/Session) et `openssl rand -hex 32` (CSRF).

# --- Serveur & URL ---
NODE_ENV="production"
PORT=3000
APP_URL="MY_APP_URL"
ALLOWED_ORIGINS="https://casavente.ma,https://www.casavente.ma"

# --- Secrets Cryptographiques ---
JWT_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64"
SESSION_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64"
CSRF_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"

# --- Base de Données Locale (SQLite) ---
SQLITE_DB_PATH="./data/casavente.sqlite"

# --- Base de Données Distante (PostgreSQL Cloud / Supabase) ---
# Pour Supabase : utilisez l'URL PgBouncer (port 6543) pour DATABASE_URL et l'URL directe (port 5432) pour DIRECT_URL.
# Pour PostgreSQL managé (Neon, RDS, Railway, etc.) : incluez toujours `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DB_SSL_MODE="require"

# --- Supabase API (Optionnel, strictement côté serveur pour SERVICE_ROLE_KEY) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"

# --- Administration & Passerelle de Paiement Maroc ---
ADMIN_BOOTSTRAP_EMAIL="admin@casavente.ma"
CMI_MERCHANT_ID=""
CMI_STORE_KEY=""

# --- GEMINI_API_KEY (Optionnel si fonctionnalités IA activées côté serveur) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
